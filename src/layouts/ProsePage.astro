---
import Base from './Base.astro';
import { pageHref, pageAlternates, type PageId } from '@/data/pages';
import { localePath, type Locale } from '@/i18n/locales';
import { useT } from '@/i18n/ui';

interface Props {
  frontmatter: { title: string; description: string; h1: string; locale: Locale; page: PageId; updated?: string; lead?: string; noindex?: boolean };
}
const { frontmatter: fm } = Astro.props;
const t = useT(fm.locale);
const path = pageHref(fm.page, fm.locale);
---
<Base locale={fm.locale} title={fm.title} description={fm.description} path={path} alternates={pageAlternates(fm.page)} noAds noindex={fm.noindex}>
  <article class="wrap-narrow page">
    <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href={localePath(fm.locale)}>{t('crumb.home')}</a></li><li><span aria-current="page">{fm.h1}</span></li></ol></nav>
    <h1>{fm.h1}</h1>
    {fm.lead && <p class="lead">{fm.lead}</p>}
    {fm.updated && <p class="updated">{t('blog.updated')} {new Date(fm.updated).toLocaleDateString(fm.locale, { year: 'numeric', month: 'long', day: 'numeric' })}</p>}
    <div class="prose"><slot /></div>
  </article>
</Base>
<style>
  .page { padding-block: 28px 40px; }
  h1 { font-size: clamp(30px, 4.4vw, 44px); letter-spacing: -0.035em; margin: 18px 0 12px; }
  .lead { margin-bottom: 8px; }
  .updated { color: var(--muted); font-size: 14px; margin-bottom: 28px; }
  .prose { margin-top: 24px; }
</style>
