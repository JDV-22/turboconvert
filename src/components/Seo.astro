---
import { SITE, ANALYTICS } from '@/config/site';
import { LOCALE_META, DEFAULT_LOCALE, type Locale } from '@/i18n/locales';

export interface Alternate { locale: Locale; href: string }
interface Props {
  title: string;
  description: string;
  path: string;
  locale: Locale;
  alternates?: Alternate[];
  jsonLd?: object[];
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
}
const { title, description, path, locale, alternates = [], jsonLd = [], noindex, ogImage = locale === 'fr' ? '/og/default-fr.png' : '/og/default.png', ogType = 'website' } = Astro.props;
const canonical = new URL(path, SITE.url).href.replace(/\/$/, '') || SITE.url;
const canonicalFixed = path === '/' ? `${SITE.url}/` : canonical;
const abs = (p: string) => (p.startsWith('http') ? p : new URL(p, SITE.url).href);
const xDefault = alternates.find((a) => a.locale === DEFAULT_LOCALE);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalFixed} />
{noindex && <meta name="robots" content="noindex, follow" />}
{alternates.length > 1 && alternates.map((a) => (
  <link rel="alternate" hreflang={LOCALE_META[a.locale].htmlLang} href={a.href === '/' ? `${SITE.url}/` : abs(a.href)} />
))}
{alternates.length > 1 && xDefault && (
  <link rel="alternate" hreflang="x-default" href={xDefault.href === '/' ? `${SITE.url}/` : abs(xDefault.href)} />
)}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalFixed} />
<meta property="og:image" content={abs(ogImage)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={abs(ogImage)} />
{ANALYTICS.googleSiteVerification && <meta name="google-site-verification" content={ANALYTICS.googleSiteVerification} />}
{jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
