---
import Icon from './Icon.astro';
import type { ToolEntry } from '@/data/catalog';

interface Props { entry: ToolEntry }
const { entry } = Astro.props;
const { from, to } = entry.tool;
---
<a class="tool-card" href={entry.href} data-cat={entry.tool.category}>
  <span class="cat-icon" data-cat={entry.tool.category}><Icon name={entry.tool.category} /></span>
  <span class="tc-body">
    <h3>{entry.copy.data.name}</h3>
    <p>{entry.copy.data.lead.split(/(?<=[.!?])\s/)[0]}</p>
    {from !== to && !['IMG', 'AUDIO', 'VIDEO'].includes(from) && (
      <span class="tc-formats"><b>{from}</b><Icon name="arrow" /><b>{to}</b></span>
    )}
  </span>
  <span class="tc-go" aria-hidden="true"><Icon name="arrow" /></span>
</a>
